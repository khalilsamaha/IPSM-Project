generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTION
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum FamilyStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum SeasonStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum ScheduleSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum AttendanceSource {
  MANUAL
  AUTOMATIC
  IMPORT
}

enum AcademicConfigStatus {
  ACTIVE
  ARCHIVED
}

enum RoomStatus {
  ACTIVE
  ARCHIVED
}

enum TeacherAvailabilityStatus {
  ACTIVE
  ARCHIVED
}

enum TeacherCompensationBasis {
  HOURLY
  SESSION_UNIT
}

enum ShiftStatus {
  OPEN
  CLOSED
  AUTO_CLOSED
  REOPENED
}

enum RegistrationAttemptStatus {
  IDENTITY_SAVED
  COMPLETED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum SchedulePatternStatus {
  ACTIVE
  ARCHIVED
}

model UserProfile {
  id               String           @id @default(uuid()) @db.Uuid
  authId           String           @unique @map("auth_id") @db.Uuid
  name             String
  email            String           @unique
  role             Role             @default(RECEPTION)
  status           UserStatus       @default(ACTIVE)
  paymentsCreated  Payment[]        @relation("PaymentCreatedBy")
  expensesCreated  Expense[]        @relation("ExpenseCreatedBy")
  shiftsOpened     CashierShift[]   @relation("ShiftOpenedBy")
  shiftsClosed     CashierShift[]   @relation("ShiftClosedBy")
  shiftsReopened   CashierShift[]   @relation("ShiftReopenedBy")
  auditLogsCreated AuditLog[]       @relation("AuditLogCreatedBy")
  approvedPayrolls TeacherPayroll[] @relation("PayrollApprovedBy")
  registrationAttempts RegistrationAttempt[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  archivedAt       DateTime?        @map("archived_at")

  @@map("users")
}

model AuditLog {
  id          String       @id @default(uuid()) @db.Uuid
  actorId     String?      @map("actor_id") @db.Uuid
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   UserProfile? @relation("AuditLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?      @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([createdById])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Family {
  id                    String       @id @default(uuid()) @db.Uuid
  familyCode            String       @unique @map("family_code")
  name                  String
  email                 String?
  phone                 String?
  fatherFirstName       String?      @map("father_first_name")
  fatherLastName        String?      @map("father_last_name")
  fatherJob             String?      @map("father_job")
  fatherPhone           String?      @map("father_phone")
  fatherEmail           String?      @map("father_email")
  motherFirstName       String?      @map("mother_first_name")
  motherLastName        String?      @map("mother_last_name")
  motherJob             String?      @map("mother_job")
  motherPhone           String?      @map("mother_phone")
  motherEmail           String?      @map("mother_email")
  address               String?
  emergencyContactName  String?      @map("emergency_contact_name")
  emergencyContactPhone String?      @map("emergency_contact_phone")
  status                FamilyStatus @default(ACTIVE)
  notes                 String?
  students              Student[]
  registrationAttempts  RegistrationAttempt[]
  payments              Payment[]
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  archivedAt            DateTime?    @map("archived_at")

  @@index([status])
  @@map("families")
}

model Student {
  id               String            @id @default(uuid()) @db.Uuid
  familyId         String            @map("family_id") @db.Uuid
  family           Family            @relation(fields: [familyId], references: [id], onDelete: Restrict)
  studentCode      String            @unique @map("student_code")
  firstName        String            @map("first_name")
  lastName         String            @map("last_name")
  email            String?
  phone            String?
  dateOfBirth      DateTime?         @map("date_of_birth") @db.Date
  status           StudentStatus     @default(ACTIVE)
  enrollments      Enrollment[]
  scheduleSessions ScheduleSession[]
  registrationAttempts RegistrationAttempt[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  archivedAt       DateTime?         @map("archived_at")

  @@index([familyId])
  @@index([studentCode])
  @@index([status])
  @@map("students")
}

model Season {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String
  startDate           DateTime              @map("start_date") @db.Date
  endDate             DateTime              @map("end_date") @db.Date
  status              SeasonStatus          @default(PLANNED)
  plannedSessionCount Int                   @default(15) @map("planned_session_count")
  enrollments         Enrollment[]
  scheduleSessions    ScheduleSession[]
  coursePricings      CoursePricing[]
  teacherAvailability TeacherAvailability[]
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  archivedAt          DateTime?             @map("archived_at")

  @@index([status, startDate, endDate])
  @@map("seasons")
}

model Teacher {
  id               String                @id @default(uuid()) @db.Uuid
  fullName         String                @map("full_name")
  phone            String?
  email            String?               @unique
  hourlyRateCents  Int                   @default(0) @map("hourly_rate_cents")
  compensationBasis TeacherCompensationBasis @default(HOURLY) @map("compensation_basis")
  sessionRateCents Int? @map("session_rate_cents")
  sessionUnitMinutes Int @default(30) @map("session_unit_minutes")
  status           TeacherStatus         @default(ACTIVE)
  notes            String?
  enrollments      Enrollment[]
  scheduleSessions ScheduleSession[]
  availability     TeacherAvailability[]
  courses          TeacherCourse[]
  payrolls         TeacherPayroll[]
  schedulePatterns SchedulePattern[]
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  archivedAt       DateTime?             @map("archived_at")

  @@index([status])
  @@map("teachers")
}

model Course {
  id             String               @id @default(uuid()) @db.Uuid
  name           String               @unique
  category       String?
  description    String?
  status         AcademicConfigStatus @default(ACTIVE)
  enrollments    Enrollment[]
  teacherCourses TeacherCourse[]
  teacherAvailability TeacherAvailability[]
  pricings       CoursePricing[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  archivedAt     DateTime?            @map("archived_at")

  @@index([status])
  @@map("courses")
}

model CourseLevel {
  id             String               @id @default(uuid()) @db.Uuid
  name           String               @unique
  order          Int                  @default(0)
  status         AcademicConfigStatus @default(ACTIVE)
  enrollments    Enrollment[]
  teacherCourses TeacherCourse[]
  pricings       CoursePricing[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  archivedAt     DateTime?            @map("archived_at")

  @@index([status, order])
  @@map("course_levels")
}

model TeacherCourse {
  id         String               @id @default(uuid()) @db.Uuid
  teacherId  String               @map("teacher_id") @db.Uuid
  teacher    Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseId   String               @map("course_id") @db.Uuid
  course     Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  levelId    String?              @map("level_id") @db.Uuid
  level      CourseLevel?         @relation(fields: [levelId], references: [id], onDelete: SetNull)
  status     AcademicConfigStatus @default(ACTIVE)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  archivedAt DateTime?            @map("archived_at")

  @@unique([teacherId, courseId, levelId])
  @@index([teacherId])
  @@index([courseId])
  @@index([levelId])
  @@index([status])
  @@map("teacher_courses")
}

model CoursePricing {
  id         String               @id @default(uuid()) @db.Uuid
  courseId   String               @map("course_id") @db.Uuid
  course     Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  levelId    String               @map("level_id") @db.Uuid
  level      CourseLevel          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  seasonId   String?              @map("season_id") @db.Uuid
  season     Season?              @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  priceCents Int                  @map("price_cents")
  status     AcademicConfigStatus @default(ACTIVE)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  @@unique([courseId, levelId, seasonId])
  @@index([courseId])
  @@index([levelId])
  @@index([seasonId])
  @@index([status])
  @@map("course_pricings")
}

model Enrollment {
  id                  String            @id @default(uuid()) @db.Uuid
  studentId           String            @map("student_id") @db.Uuid
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  seasonId            String            @map("season_id") @db.Uuid
  season              Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  teacherId           String?           @map("teacher_id") @db.Uuid
  teacher             Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  courseName          String            @map("course_name")
  courseId            String?           @map("course_id") @db.Uuid
  course              Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  levelId             String?           @map("level_id") @db.Uuid
  level               CourseLevel?      @relation(fields: [levelId], references: [id], onDelete: SetNull)
  feeCents            Int               @default(0) @map("fee_cents")
  discountCents       Int               @default(0) @map("discount_cents")
  finalFeeCents       Int               @default(0) @map("final_fee_cents")
  paidCents           Int               @default(0) @map("paid_cents")
  remainingCents      Int               @default(0) @map("remaining_cents")
  configuredPriceCents  Int?            @map("configured_price_cents")
  priceBaseSessionCount Int?            @map("price_base_session_count")
  plannedSessionCount   Int?            @map("planned_session_count")
  calculatedFeeCents    Int?            @map("calculated_fee_cents")
  pricingSourceId       String?          @map("pricing_source_id") @db.Uuid
  pricingCalculatedAt   DateTime?        @map("pricing_calculated_at")
  pricingOverrideReason String?          @map("pricing_override_reason")
  enrollmentStartDate DateTime          @map("enrollment_start_date") @db.Date
  enrollmentEndDate   DateTime          @map("enrollment_end_date") @db.Date
  status              EnrollmentStatus  @default(ACTIVE)
  paymentItems        PaymentItem[]
  scheduleSessions    ScheduleSession[]
  schedulePatterns    SchedulePattern[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  archivedAt          DateTime?         @map("archived_at")
  registrationSubmissionId String?      @unique @map("registration_submission_id") @db.Uuid
  registrationAttempt RegistrationAttempt?

  @@index([studentId, seasonId, courseId, levelId])
  @@index([studentId])
  @@index([seasonId])
  @@index([teacherId])
  @@index([courseId])
  @@index([levelId])
  @@index([status])
  @@map("enrollments")
}

model RegistrationAttempt {
  id                String                    @id @db.Uuid
  status            RegistrationAttemptStatus @default(IDENTITY_SAVED)
  familyId          String                    @map("family_id") @db.Uuid
  family            Family                    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  primaryStudentId  String                    @map("primary_student_id") @db.Uuid
  primaryStudent    Student                   @relation(fields: [primaryStudentId], references: [id], onDelete: Restrict)
  enrollmentId      String?                   @unique @map("enrollment_id") @db.Uuid
  enrollment        Enrollment?               @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  paymentId         String?                   @unique @map("payment_id") @db.Uuid
  payment           Payment?                  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  lastFailureReason String?                   @map("last_failure_reason")
  createdById       String?                   @map("created_by_id") @db.Uuid
  createdBy         UserProfile?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  @@index([familyId])
  @@index([primaryStudentId])
  @@index([status])
  @@map("registration_attempts")
}

model ScheduleSession {
  id           String                @id @default(uuid()) @db.Uuid
  studentId    String                @map("student_id") @db.Uuid
  student      Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacherId    String                @map("teacher_id") @db.Uuid
  teacher      Teacher               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  enrollmentId String?               @map("enrollment_id") @db.Uuid
  enrollment   Enrollment?           @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  seasonId     String?               @map("season_id") @db.Uuid
  season       Season?               @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  roomId       String?               @map("room_id") @db.Uuid
  room         Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  title        String?
  sessionDate  DateTime              @map("session_date") @db.Date
  startTime    String                @map("start_time")
  endTime      String                @map("end_time")
  status       ScheduleSessionStatus @default(SCHEDULED)
  notes        String?
  attendanceFinalizedAt DateTime? @map("attendance_finalized_at")
  attendanceFinalizedBy String? @map("attendance_finalized_by") @db.Uuid
  attendanceSource AttendanceSource? @map("attendance_source")
  attendanceReason String? @map("attendance_reason")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  archivedAt   DateTime?             @map("archived_at")
  payrollItems TeacherPayrollItem[]
  schedulePatternId String? @map("schedule_pattern_id") @db.Uuid
  schedulePattern SchedulePattern? @relation(fields: [schedulePatternId], references: [id], onDelete: SetNull)

  @@index([studentId, sessionDate])
  @@index([teacherId, sessionDate])
  @@index([sessionDate, startTime])
  @@index([enrollmentId])
  @@index([seasonId, sessionDate])
  @@index([seasonId])
  @@index([roomId, sessionDate])
  @@index([status, sessionDate])
  @@index([status])
  @@unique([schedulePatternId, sessionDate])
  @@map("schedule_sessions")
}

model Room {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  capacity         Int?
  description      String?
  status           RoomStatus        @default(ACTIVE)
  scheduleSessions ScheduleSession[]
  schedulePatterns SchedulePattern[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  archivedAt       DateTime?         @map("archived_at")

  @@index([status])
  @@map("rooms")
}

model SchedulePattern {
  id String @id @default(uuid()) @db.Uuid
  enrollmentId String @map("enrollment_id") @db.Uuid
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  teacherId String @map("teacher_id") @db.Uuid
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  roomId String? @map("room_id") @db.Uuid
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  dayOfWeek Int @map("day_of_week")
  startTime String @map("start_time")
  endTime String @map("end_time")
  startsOn DateTime @map("starts_on") @db.Date
  endsOn DateTime @map("ends_on") @db.Date
  status SchedulePatternStatus @default(ACTIVE)
  sessions ScheduleSession[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  @@index([enrollmentId])
  @@index([teacherId, dayOfWeek])
  @@map("schedule_patterns")
}

model SchoolClosure {
  id String @id @default(uuid()) @db.Uuid
  name String
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime @map("end_date") @db.Date
  notes String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  @@index([startDate, endDate])
  @@map("school_closures")
}

model TeacherAvailability {
  id            String                    @id @default(uuid()) @db.Uuid
  teacherId     String                    @map("teacher_id") @db.Uuid
  teacher       Teacher                   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseId      String?                   @map("course_id") @db.Uuid
  course        Course?                   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  dayOfWeek     Int                       @map("day_of_week")
  startTime     String                    @map("start_time")
  endTime       String                    @map("end_time")
  seasonId      String?                   @map("season_id") @db.Uuid
  season        Season?                   @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  effectiveFrom DateTime?                 @map("effective_from") @db.Date
  effectiveTo   DateTime?                 @map("effective_to") @db.Date
  status        TeacherAvailabilityStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  archivedAt    DateTime?                 @map("archived_at")

  @@index([teacherId, dayOfWeek, status])
  @@index([seasonId])
  @@index([courseId])
  @@map("teacher_availability")
}

model TeacherPayroll {
  id                      String               @id @default(uuid()) @db.Uuid
  teacherId               String               @map("teacher_id") @db.Uuid
  teacher                 Teacher              @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  periodStart             DateTime             @map("period_start") @db.Date
  periodEnd               DateTime             @map("period_end") @db.Date
  payrollMonth            DateTime?            @map("payroll_month") @db.Date
  hourlyRateSnapshotCents Int                  @map("hourly_rate_snapshot_cents")
  compensationBasisSnapshot TeacherCompensationBasis? @map("compensation_basis_snapshot")
  rateUnitMinutesSnapshot Int? @map("rate_unit_minutes_snapshot")
  completedMinutes        Int                  @default(0) @map("completed_minutes")
  missedPayableMinutes    Int                  @default(0) @map("missed_payable_minutes")
  adjustmentCents         Int                  @default(0) @map("adjustment_cents")
  grossAmountCents        Int                  @default(0) @map("gross_amount_cents")
  status                  PayrollStatus        @default(DRAFT)
  approvedById            String?              @map("approved_by_id") @db.Uuid
  approvedBy              UserProfile?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt              DateTime?            @map("approved_at")
  paidAt                  DateTime?            @map("paid_at")
  notes                   String?
  expense                 Expense?
  items                   TeacherPayrollItem[]
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  @@index([teacherId, periodStart, periodEnd])
  @@index([status])
  @@unique([teacherId, payrollMonth])
  @@map("teacher_payrolls")
}


model OperationalSettings {
  id                             String   @id
  attendanceAutoFinalizeEnabled Boolean  @default(true) @map("attendance_auto_finalize_enabled")
  attendanceFinalizeGraceMinutes Int     @default(15) @map("attendance_finalize_grace_minutes")
  allowPayableMissedLessons      Boolean  @default(false) @map("allow_payable_missed_lessons")
  updatedAt                      DateTime @updatedAt @map("updated_at")
  updatedById                    String?  @map("updated_by_id") @db.Uuid

  @@map("operational_settings")
}

model TeacherPayrollItem {
  id                String           @id @default(uuid()) @db.Uuid
  payrollId         String           @map("payroll_id") @db.Uuid
  payroll           TeacherPayroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  scheduleSessionId String?          @map("schedule_session_id") @db.Uuid
  scheduleSession   ScheduleSession? @relation(fields: [scheduleSessionId], references: [id], onDelete: Restrict)
  sessionDate       DateTime         @map("session_date") @db.Date
  startTime         String           @map("start_time")
  endTime           String           @map("end_time")
  minutes           Int
  rateSnapshotCents Int              @map("rate_snapshot_cents")
  compensationBasisSnapshot TeacherCompensationBasis? @map("compensation_basis_snapshot")
  rateUnitMinutesSnapshot Int? @map("rate_unit_minutes_snapshot")
  amountCents       Int              @map("amount_cents")
  itemType          String           @map("item_type")
  notes             String?

  @@unique([scheduleSessionId])
  @@index([payrollId])
  @@index([sessionDate])
  @@map("teacher_payroll_items")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  familyId         String        @map("family_id") @db.Uuid
  family           Family        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  paymentDate      DateTime      @default(now()) @map("payment_date") @db.Date
  paymentMethod    String        @map("payment_method")
  totalAmountCents Int           @map("total_amount_cents")
  notes            String?
  createdById      String?       @map("created_by_id") @db.Uuid
  createdBy        UserProfile?  @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  receiptNumber    String?       @unique @map("receipt_number")
  shiftId          String?       @map("shift_id") @db.Uuid
  shift            CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  voidedAt         DateTime?     @map("voided_at")
  items            PaymentItem[]
  receipt          Receipt?
  registrationAttempt RegistrationAttempt?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([familyId])
  @@index([createdById])
  @@index([shiftId])
  @@index([paymentDate])
  @@map("payments")
}

model PaymentItem {
  id           String     @id @default(uuid()) @db.Uuid
  paymentId    String     @map("payment_id") @db.Uuid
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  enrollmentId String     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  amountCents  Int        @map("amount_cents")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([paymentId, enrollmentId])
  @@index([paymentId])
  @@index([enrollmentId])
  @@map("payment_items")
}

model Receipt {
  id                 String    @id @default(uuid()) @db.Uuid
  paymentId          String    @unique @map("payment_id") @db.Uuid
  payment            Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receiptNumber      String    @unique @map("receipt_number")
  pdfPath            String?   @map("pdf_path")
  generatedAt        DateTime  @default(now()) @map("generated_at")
  sentByEmailAt      DateTime? @map("sent_by_email_at")
  sharedByWhatsappAt DateTime? @map("shared_by_whatsapp_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")

  @@index([generatedAt])
  @@map("receipts")
}

// Selection catalogue; expenses retain their original category label for reporting.
model ExpenseCategory {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Case-insensitive uniqueness is enforced by the SQL expression index.
  @@map("expense_categories")
}

model Expense {
  payrollId     String?       @unique @map("payroll_id") @db.Uuid
  payroll       TeacherPayroll? @relation(fields: [payrollId], references: [id], onDelete: Restrict)
  id            String        @id @default(uuid()) @db.Uuid
  createdById   String?       @map("created_by_id") @db.Uuid
  createdBy     UserProfile?  @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  category      String
  description   String
  amountCents   Int           @map("amount_cents")
  incurredAt    DateTime      @default(now()) @map("incurred_at") @db.Date
  expenseDate   DateTime      @default(now()) @map("expense_date") @db.Date
  paymentMethod String        @default("cash") @map("payment_method")
  shiftId       String?       @map("shift_id") @db.Uuid
  shift         CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now()) @map("created_at")
  archivedAt    DateTime?     @map("archived_at")

  @@index([createdById])
  @@index([shiftId])
  @@index([expenseDate])
  @@map("expenses")
}

model CashierShift {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              UserProfile  @relation("ShiftOpenedBy", fields: [userId], references: [id], onDelete: Restrict)
  businessDate      DateTime     @map("business_date") @db.Date
  openedAt          DateTime     @default(now()) @map("opened_at")
  closedAt          DateTime?    @map("closed_at")
  openingCashCents  Int          @map("opening_cash_cents")
  expectedCashCents Int          @default(0) @map("expected_cash_cents")
  declaredCashCents Int?         @map("declared_cash_cents")
  differenceCents   Int?         @map("difference_cents")
  status            ShiftStatus  @default(OPEN)
  notes             String?
  closedById        String?      @map("closed_by_id") @db.Uuid
  closedBy          UserProfile? @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  reopenedById      String?      @map("reopened_by_id") @db.Uuid
  reopenedBy        UserProfile? @relation("ShiftReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)
  reopenReason      String?      @map("reopen_reason")
  closingSnapshot   Json?        @map("closing_snapshot")
  varianceReason    String?      @map("variance_reason")
  payments          Payment[]
  expenses          Expense[]
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([businessDate])
  @@map("cashier_shifts")
}

// Protected reset infrastructure: never included in reset deletion plans.
model ProductionResetRequest {
  id        String @id @default(uuid()) @db.Uuid
  actorId   String @map("actor_id") @db.Uuid
  selection Json
  fingerprint String
  preview Json
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  result Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([actorId, createdAt])
  @@map("production_reset_requests")
}

model ProductionResetState {
  id String @id
  changedAt DateTime @map("changed_at") @db.Timestamptz(6)
  @@map("production_reset_state")
}

model BusinessIdentifierCounter {
  key String @id
  value BigInt
  @@map("business_identifier_counters")
}

model IssuedBusinessIdentifier {
  kind String
  value String
  ownerId String? @map("owner_id") @db.Uuid
  namespace String?
  issuanceYear Int? @map("issuance_year")
  serial BigInt?
  @@id([kind, value])
  @@map("issued_business_identifiers")
}

model ResetRegistrationSubmission {
  id String @id @db.Uuid
  resetAt DateTime @default(now()) @map("reset_at")
  @@map("reset_registration_submissions")
}


model BusinessIdentifierActivation {
  id String @id @db.Uuid
  namespace String @default("IPSM")
  enabled Boolean @default(false)
  nonUseSha256 String @map("non_use_sha256")
  recoverySha256 String @map("recovery_sha256")
  approvedBy String @map("approved_by")
  databaseOid BigInt @map("database_oid")
  serverStartedAt DateTime @map("server_started_at") @db.Timestamptz(6)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  @@map("business_identifier_activations")
}
model BusinessIdentifierAllocation {
  kind String
  ownerId String @map("owner_id") @db.Uuid
  issuanceYear Int @map("issuance_year")
  activationId String @map("activation_id") @db.Uuid
  value String
  transactionId String @map("transaction_id")
  @@id([kind, ownerId])
  @@unique([kind, value])
  @@map("business_identifier_allocations")
}
model BusinessIdentifierImport {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind String
  value String
  ownerId String? @map("owner_id") @db.Uuid
  purpose String
  manifestSha256 String @map("manifest_sha256")
  approvedBy String @map("approved_by")
  transactionId String @map("transaction_id")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  @@map("business_identifier_imports")
}
